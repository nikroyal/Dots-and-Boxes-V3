rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES
// Paste these into Firebase Console -> Firestore Database -> Rules -> Publish
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers ----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function protectedUserKeysChanged() {
      return changedKeys().hasAny(['role', 'status', 'chatMuted', 'moderationNote']);
    }

    // Username lookups --------------------------------------------------------
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // User profiles ----------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSelf(userId)
                    && request.resource.data.username is string
                    && request.resource.data.get('role', 'player') == 'player'
                    && request.resource.data.get('status', 'active') == 'active';

      allow update: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.username == resource.data.username
          && !protectedUserKeysChanged()
        )
        || (
          changedKeys().hasOnly(['friends', 'outgoingFriendRequests'])
          && request.resource.data.friends.size() == (resource.data.get('friends', []).size() + 1)
          && request.resource.data.friends.hasAll(resource.data.get('friends', []))
          && request.resource.data.friends[request.resource.data.friends.size() - 1] == request.auth.uid
          && (request.auth.uid in resource.data.get('outgoingFriendRequests', []))
          && !(request.auth.uid in request.resource.data.get('outgoingFriendRequests', []))
          && resource.data.get('outgoingFriendRequests', []).hasAll(request.resource.data.get('outgoingFriendRequests', []))
        )
        || (
          changedKeys().hasOnly(['friends'])
          && request.resource.data.friends.size() == (resource.data.get('friends', []).size() - 1)
          && resource.data.get('friends', []).hasAll(request.resource.data.friends)
          && !(request.auth.uid in request.resource.data.friends)
          && (request.auth.uid in resource.data.get('friends', []))
        )
        || (
          changedKeys().hasOnly(['outgoingFriendRequests'])
          && request.resource.data.get('outgoingFriendRequests', []).size() == (resource.data.get('outgoingFriendRequests', []).size() - 1)
          && !(request.auth.uid in request.resource.data.get('outgoingFriendRequests', []))
          && (request.auth.uid in resource.data.get('outgoingFriendRequests', []))
          && resource.data.get('outgoingFriendRequests', []).hasAll(request.resource.data.get('outgoingFriendRequests', []))
        )
        || (
          changedKeys().hasOnly(['friendRequests'])
          && request.resource.data.friendRequests.size() == (resource.data.get('friendRequests', []).size() + 1)
          && request.resource.data.friendRequests.hasAll(resource.data.get('friendRequests', []))
          && request.resource.data.friendRequests[request.resource.data.friendRequests.size() - 1].fromId == request.auth.uid
        )
      );

      allow delete: if isSelf(userId) || isAdmin();
    }

    // Invites ----------------------------------------------------------------
    match /invites/{inviteId} {
      allow read: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.fromId
        || request.auth.uid == resource.data.toId
      ));
      allow create: if isSignedIn()
                    && request.resource.data.fromId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.fromId
        || request.auth.uid == resource.data.toId
      ));
      allow delete: if isAdmin() || (isSignedIn()
                    && request.auth.uid == resource.data.fromId);
    }


    // Matches ----------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.players;

      function isPlayer() {
        return isSignedIn() && request.auth.uid in resource.data.players;
      }
      function specJoin() {
        return changedKeys().hasOnly(['spectators'])
          && request.resource.data.spectators.size() == (resource.data.get('spectators', []).size() + 1)
          && request.resource.data.spectators.hasAll(resource.data.get('spectators', []))
          && request.resource.data.spectators[request.resource.data.spectators.size() - 1].id == request.auth.uid;
      }
      function specLeave() {
        // Note: spectators is kept as an array of maps for frontend compatibility;
        // checking request.auth.uid inside list of maps is limited by Firestore rule capabilities.
        return changedKeys().hasOnly(['spectators'])
          && request.resource.data.spectators.size() == (resource.data.get('spectators', []).size() - 1)
          && resource.data.get('spectators', []).hasAll(request.resource.data.spectators);
      }
      function chatAppend() {
        return changedKeys().hasOnly(['chat'])
          && request.resource.data.chat.size() == (resource.data.get('chat', []).size() + 1)
          && request.resource.data.chat.hasAll(resource.data.get('chat', []))
          && request.resource.data.chat[request.resource.data.chat.size() - 1].userId == request.auth.uid;
      }
      function isHostJoining() {
        return isSignedIn()
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'active'
          && request.auth.uid in request.resource.data.players;
      }

      allow update: if isAdmin() || isPlayer() || specJoin() || specLeave() || chatAppend() || isHostJoining();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.status == 'waiting' && request.auth.uid in resource.data.players);
    }

    // Direct Message Conversations ------------------------------------------
    match /conversations/{convId} {
      allow read: if isAdmin() || (isSignedIn()
                  && request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0] < request.resource.data.participants[1]
                    && convId == (request.resource.data.participants[0] + '_' + request.resource.data.participants[1]);

      function protectedConvKeysChanged() {
        return changedKeys().hasAny(['participants', 'requestedBy', 'createdAt']);
      }

      allow update: if isAdmin() || (isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && !protectedConvKeysChanged());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAdmin() || (isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);
        allow create: if isSignedIn()
                      && request.resource.data.fromId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update, delete: if isAdmin();
      }
    }

    // Clubs ------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds.size() == 1
                    && request.resource.data.memberIds[0] == request.auth.uid
                    && request.resource.data.memberCount == 1
                    && request.resource.data.isPublic is bool
                    && (
                      (request.resource.data.isPublic == true && request.resource.data.joinMode == 'open')
                      || (request.resource.data.isPublic == false && request.resource.data.joinMode == 'approval')
                    );

      function getMyRole() {
        return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role;
      }
      function canManageClub() {
        return isSignedIn() && getMyRole() in ['owner', 'admin'];
      }
      function canManageMembers() {
        return isSignedIn() && getMyRole() in ['owner', 'admin', 'moderator'];
      }
      function canReadClubMessages() {
        return isSignedIn() && (
          get(/databases/$(database)/documents/clubs/$(clubId)).data.isPublic == true
          || exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid))
        );
      }
      function memberIdsBefore() {
        return resource.data.get('memberIds', []);
      }
      function memberIdsAfter() {
        return request.resource.data.memberIds;
      }
      function validMetadataUpdate() {
        return canManageClub()
          && changedKeys().hasOnly(['name', 'description', 'isPublic', 'joinMode']);
      }
      function validManagedMemberListUpdate() {
        return canManageMembers()
          && changedKeys().hasOnly(['memberCount', 'memberIds']);
      }
      function validJoinUpdate() {
        return isSignedIn()
          && changedKeys().hasOnly(['memberCount', 'memberIds'])
          && !(request.auth.uid in memberIdsBefore())
          && request.auth.uid in memberIdsAfter()
          && memberIdsAfter().size() == memberIdsBefore().size() + 1
          && memberIdsAfter().hasAll(memberIdsBefore())
          && request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1
          && getAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role == 'member';
      }
      function validLeaveUpdate() {
        return isSignedIn()
          && changedKeys().hasOnly(['memberCount', 'memberIds'])
          && request.auth.uid in memberIdsBefore()
          && !(request.auth.uid in memberIdsAfter())
          && memberIdsBefore().hasAll(memberIdsAfter())
          && memberIdsAfter().size() == memberIdsBefore().size() - 1
          && request.resource.data.memberCount == resource.data.get('memberCount', 1) - 1
          && get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role != 'owner'
          && !existsAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
      }

      allow update: if isAdmin()
                    || validMetadataUpdate()
                    || validManagedMemberListUpdate()
                    || validJoinUpdate()
                    || validLeaveUpdate();

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /members/{userId} {
        allow read: if isSignedIn();

        function listedAfter() {
          return userId in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('memberIds', []);
        }
        function validMemberCreate() {
          return isSignedIn()
            && request.resource.data.userId == userId
            && listedAfter()
            && (
              (
                request.auth.uid == userId
                && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid
                && request.resource.data.role == 'owner'
              )
              || (
                request.auth.uid == userId
                && request.resource.data.role == 'member'
              )
              || (
                get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
                && request.resource.data.role == 'member'
              )
            );
        }
        function validRoleUpdate() {
          return isSignedIn()
            && get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role == 'owner'
            && request.auth.uid != userId
            && resource.data.role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['admin', 'moderator', 'member'];
        }
        function validMemberDelete() {
          return isSignedIn()
            && resource.data.role != 'owner'
            && !(userId in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('memberIds', []))
            && (
              request.auth.uid == userId
              || get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator']
            );
        }

        allow create: if isAdmin() || validMemberCreate();
        allow update: if isAdmin() || validRoleUpdate();
        allow delete: if isAdmin() || validMemberDelete();
      }

      match /channels/{channelId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || (isSignedIn() && (
          getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
        ));
        allow update, delete: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']);

        match /messages/{msgId} {
          allow read: if isAdmin() || canReadClubMessages();
          allow create: if isSignedIn() && exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
          allow update, delete: if isAdmin() || (isSignedIn() && (
            request.auth.uid == resource.data.userId
            || get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator']
          ));
        }
      }

      match /joinRequests/{userId} {
        allow read: if isAdmin() || (isSignedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
        ));
        allow create: if isSignedIn()
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && !(userId in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('memberIds', []));
        allow delete: if isAdmin() || (isSignedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
        ));
      }
    }

    // Activity feed entries --------------------------------------------------
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin audit log --------------------------------------------------------
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
